server {
    listen 80;
    server_name __SERVER_NAME__;

    location = / {
        return 302 __SITE_PATH__;
    }

    location __SITE_PATH__ {
        alias __PUBLIC_DIR__/;
        index index.html;
        try_files $uri $uri/ __SITE_PATH__index.html;
    }

    location /api/ {
        proxy_pass __API_BASE_URL__/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~* ^__SITE_PATH__(.*)\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
        try_files $uri =404;
    }
}
