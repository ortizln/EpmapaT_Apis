# SRI-FILES — Archivo de ejemplo de variables de entorno
# Copiar a .env y completar con valores reales

# ===== DATABASE =====
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sri_files
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_password_here

# ===== SERVER =====
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/

# ===== SRI CONFIGURATION =====
SRI_AMBIENTE=pruebas
# Valores válidos: pruebas, produccion

# ===== ERP BACKEND =====
ERP_BACKEND_BASE_URL=http://localhost:8081

# ===== EMAIL SERVICE =====
EMAIL_MS_BASE_URL=http://localhost:8082

# ===== SECURITY =====
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# ===== DIGITAL CERTIFICATE =====
CERTIFICATE_PATH=/secrets/certificate.p12
CERTIFICATE_PASSWORD=your_certificate_password_here

# ===== SRI SCHEDULING =====
# Formato cron para envío automático de facturas
CRON_ENVIO_FACTURAS=0 0/5 * * * ?

# Formato cron para consulta de autorizaciones
CRON_CONSULTA_AUTORIZACIONES=0 */1 * * * ?

# ===== LOGGING =====
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_ERP_SRI_FILES=DEBUG
