<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="base_guia_remision" pageWidth="595" pageHeight="842" columnWidth="515"
              leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30">
    <parameter name="RazonSocial" class="java.lang.String"/>
    <parameter name="NumeroDocumento" class="java.lang.String"/>
    <parameter name="fechaIniTransporte" class="java.lang.String"/>
    <parameter name="fechaFinTransporte" class="java.lang.String"/>
    <field name="identificacionDestinatario" class="java.lang.String"/>
    <field name="razonSocialDestinatario" class="java.lang.String"/>
    <field name="dirDestinatario" class="java.lang.String"/>
    <title>
        <band height="80">
            <staticText><reportElement x="0" y="0" width="515" height="24"/><textElement textAlignment="Center"><font size="16" isBold="true"/></textElement><text><![CDATA[GUIA DE REMISION]]></text></staticText>
            <textField><reportElement x="0" y="30" width="250" height="18"/><textFieldExpression><![CDATA[$P{RazonSocial}]]></textFieldExpression></textField>
            <textField><reportElement x="280" y="30" width="235" height="18"/><textFieldExpression><![CDATA["No: " + $P{NumeroDocumento}]]></textFieldExpression></textField>
        </band>
    </title>
    <detail>
        <band height="20">
            <textField><reportElement x="0" y="0" width="120" height="20"/><textFieldExpression><![CDATA[$F{identificacionDestinatario}]]></textFieldExpression></textField>
            <textField><reportElement x="120" y="0" width="180" height="20"/><textFieldExpression><![CDATA[$F{razonSocialDestinatario}]]></textFieldExpression></textField>
            <textField><reportElement x="300" y="0" width="215" height="20"/><textFieldExpression><![CDATA[$F{dirDestinatario}]]></textFieldExpression></textField>
        </band>
    </detail>
</jasperReport>
