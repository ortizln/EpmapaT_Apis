<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="base_nota_credito" pageWidth="595" pageHeight="842" columnWidth="515"
              leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30">
    <parameter name="RazonSocial" class="java.lang.String"/>
    <parameter name="NumeroDocumento" class="java.lang.String"/>
    <parameter name="FechaEmision" class="java.lang.String"/>
    <parameter name="razonSocialComprador" class="java.lang.String"/>
    <parameter name="valorModificacion" class="java.lang.String"/>
    <field name="codigoPrincipal" class="java.lang.String"/>
    <field name="descripcion" class="java.lang.String"/>
    <field name="cantidad" class="java.lang.String"/>
    <title>
        <band height="80">
            <staticText><reportElement x="0" y="0" width="515" height="24"/><textElement textAlignment="Center"><font size="16" isBold="true"/></textElement><text><![CDATA[NOTA DE CREDITO]]></text></staticText>
            <textField><reportElement x="0" y="30" width="250" height="18"/><textFieldExpression><![CDATA[$P{RazonSocial}]]></textFieldExpression></textField>
            <textField><reportElement x="280" y="30" width="235" height="18"/><textFieldExpression><![CDATA["No: " + $P{NumeroDocumento}]]></textFieldExpression></textField>
            <textField><reportElement x="0" y="52" width="515" height="18"/><textFieldExpression><![CDATA["Cliente: " + $P{razonSocialComprador} + "  Valor: " + $P{valorModificacion}]]></textFieldExpression></textField>
        </band>
    </title>
    <detail>
        <band height="20">
            <textField><reportElement x="0" y="0" width="90" height="20"/><textFieldExpression><![CDATA[$F{codigoPrincipal}]]></textFieldExpression></textField>
            <textField><reportElement x="90" y="0" width="325" height="20"/><textFieldExpression><![CDATA[$F{descripcion}]]></textFieldExpression></textField>
            <textField><reportElement x="415" y="0" width="100" height="20"/><textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression></textField>
        </band>
    </detail>
</jasperReport>
